<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Support\Endianness.cs" />
    <Compile Remove="Support\SpanStream.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- smx-smx/discutils fork (branch next) via submodule; was LTRData.DiscUtils.SquashFs 0.16.13 from nuget -->
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.SquashFs\DiscUtils.SquashFs.csproj" />
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.SquashFs3\DiscUtils.SquashFs3.csproj" />
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.Jffs2\DiscUtils.Jffs2.csproj" />
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.Ufs\DiscUtils.Ufs.csproj" />
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.Ext\DiscUtils.Ext.csproj" />
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.Fat\DiscUtils.Fat.csproj" />
    <ProjectReference Include="..\extern\DiscUtils\Library\DiscUtils.Vdfs\DiscUtils.Vdfs.csproj" />
    <!-- smx-smx/Smx.SharpIO (branch next) via submodule; was Smx.SharpIO 2.0-beta.3 from nuget -->
    <ProjectReference Include="..\extern\Smx.SharpIO\SharpIO\SharpIO\SharpIO.csproj" />
    <PackageReference Include="log4net" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Yafex.Cygwin\Yafex.Cygwin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
