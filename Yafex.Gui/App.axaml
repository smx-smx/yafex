<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yafex.Gui.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ChromeBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="PaneBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#DADDE2" />
                    <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="OffsetBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="FolderBrush" Color="#E3A21A" />
                    <SolidColorBrush x:Key="ArchiveBrush" Color="#7C3AED" />
                    <SolidColorBrush x:Key="FileBrush" Color="#8A94A6" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#EDE9FE" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#5B21B6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ChromeBrush" Color="#1F2125" />
                    <SolidColorBrush x:Key="PaneBrush" Color="#18191C" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#33363C" />
                    <SolidColorBrush x:Key="FieldBrush" Color="#121316" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="OffsetBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="FolderBrush" Color="#F2B84B" />
                    <SolidColorBrush x:Key="ArchiveBrush" Color="#A78BFA" />
                    <SolidColorBrush x:Key="FileBrush" Color="#8B95A7" />
                    <SolidColorBrush x:Key="BadgeBrush" Color="#2E2550" />
                    <SolidColorBrush x:Key="BadgeTextBrush" Color="#DDD6FE" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Liberation Mono,monospace</FontFamily>

            <!-- Material Design icon paths (Apache 2.0), 24x24 -->
            <StreamGeometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</StreamGeometry>
            <StreamGeometry x:Key="IconFolderOpen">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z</StreamGeometry>
            <StreamGeometry x:Key="IconFile">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z</StreamGeometry>
            <StreamGeometry x:Key="IconArchive">M14,17H12V15H10V13H12V15H14M14,9H12V11H14V13H12V11H10V9H12V7H10V5H12V7H14M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z</StreamGeometry>
            <StreamGeometry x:Key="IconChip">M6,4H18V5H21V7H18V9H21V11H18V13H21V15H18V17H21V19H18V20H6V19H3V17H6V15H3V13H6V11H3V9H6V7H3V5H6V4M11,15V18H12V15H11M13,15V18H14V15H13M15,15V18H16V15H15Z</StreamGeometry>
            <StreamGeometry x:Key="IconBack">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</StreamGeometry>
            <StreamGeometry x:Key="IconForward">M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z</StreamGeometry>
            <StreamGeometry x:Key="IconUp">M13,20H11V8L5.5,13.5L4.08,12.08L12,4.16L19.92,12.08L18.5,13.5L13,8V20Z</StreamGeometry>
            <StreamGeometry x:Key="IconKey">M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z</StreamGeometry>
            <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
            <StreamGeometry x:Key="IconExport">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
            <StreamGeometry x:Key="IconSubfolders">M3,3H9V7H3V3M15,10H21V14H15V10M15,17H21V21H15V17M13,13H7V18H13V20H7L5,20V9H7V11H13V13Z</StreamGeometry>
            <StreamGeometry x:Key="IconCopy">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Yafex.Gui/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
