<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
    </Style>

    <!-- chrome bars -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style Selector="Border.statusbar TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pane">
        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
    </Style>
    <Style Selector="Border.vsep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
        <Setter Property="MinWidth" Value="1" />
    </Style>

    <!-- flat toolbar buttons -->
    <Style Selector="Button.tool, ToggleButton.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool:disabled PathIcon">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.tool PathIcon, ToggleButton.tool PathIcon, MenuItem PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Button.tool TextBlock, ToggleButton.tool TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- breadcrumb bar -->
    <Style Selector="Border.pathbar">
        <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="Button.crumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.crumb:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>
    <Style Selector="TextBlock.crumbsep">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="1,0" />
    </Style>

    <!-- entry icons -->
    <Style Selector="PathIcon.folder">
        <Setter Property="Foreground" Value="{DynamicResource FolderBrush}" />
    </Style>
    <Style Selector="PathIcon.archive">
        <Setter Property="Foreground" Value="{DynamicResource ArchiveBrush}" />
    </Style>
    <Style Selector="PathIcon.file">
        <Setter Property="Foreground" Value="{DynamicResource FileBrush}" />
    </Style>
    <Style Selector="PathIcon.entry">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- "contains squashfs" badge -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BadgeBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- dense lists -->
    <Style Selector="TreeView TreeViewItem">
        <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
        <Setter Property="RowHeight" Value="26" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
    </Style>
    <Style Selector="ListBox.hex">
        <Setter Property="Background" Value="{DynamicResource PaneBrush}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.hex ListBoxItem">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="18" />
    </Style>
    <Style Selector="TabControl.preview TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
</Styles>
